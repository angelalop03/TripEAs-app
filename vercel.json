{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/viaje/:id", "destination": "/viaje/[id]" },
    { "source": "/viaje/:id/:pagina", "destination": "/viaje/[id]/:pagina" }
  ],
  "functions": {
    "api/mantener-activo.js": { "maxDuration": 180 }
  },
  "crons": [
    { "path": "/api/mantener-activo", "schedule": "0 7 * * *" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
